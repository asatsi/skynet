      "name": "Lab Results",
      "description": "Endpoints for managing lab results",
      "item": [
        {
          "name": "Get All Lab Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ehr/lab-results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "lab-results"]
            },
            "description": "Retrieve all lab results in the system."
