          "name": "Create Lab Result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1001,\n  \"testName\": \"Complete Blood Count\",\n  \"testCode\": \"CBC-001\",\n  \"testDate\": \"2024-05-10\",\n  \"resultValue\": \"5.4\",\n  \"unit\": \"million cells/mcL\",\n  \"referenceRange\": \"4.5-5.5\",\n  \"status\": \"COMPLETED\",\n  \"orderedBy\": \"Dr. Sarah Johnson\",\n  \"notes\": \"Fasting sample collected at 8 AM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/lab-results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "lab-results"]
            },
            "description": "Create a new lab result for a patient."
          },
          "response": []
        }
      ]
    },
