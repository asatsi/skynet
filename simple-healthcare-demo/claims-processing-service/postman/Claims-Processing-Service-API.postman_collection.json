        {
          "name": "Create Claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimNumber\": \"CLM-2024-001\",\n  \"patientId\": 1001,\n  \"policyNumber\": \"POL-2024-5678\",\n  \"claimDate\": \"2024-01-15\",\n  \"claimAmount\": 2500.00,\n  \"status\": \"SUBMITTED\",\n  \"description\": \"Emergency room visit for severe abdominal pain. Includes CT scan, lab work, and physician consultation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims"]
            },
            "description": "Submit a new insurance claim. Status defaults to SUBMITTED if not provided."
          },
          "response": []
        },
        {
          "name": "Update Claim",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimNumber\": \"CLM-2024-001\",\n  \"patientId\": 1001,\n  \"policyNumber\": \"POL-2024-5678\",\n  \"claimDate\": \"2024-01-15\",\n  \"claimAmount\": 2750.00,\n  \"status\": \"UNDER_REVIEW\",\n  \"description\": \"Emergency room visit for severe abdominal pain. Updated to include additional radiology charges.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "1"]
            },
            "description": "Update an existing claim with new details. All fields are replaced."
          },
          "response": []
        },
        {
          "name": "Delete Claim",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/claims/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "1"]
            },
            "description": "Delete a claim by its ID. Returns 204 No Content on success."
          },
          "response": []
        }
      ]
    },
