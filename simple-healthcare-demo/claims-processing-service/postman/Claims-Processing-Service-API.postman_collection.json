{
  "info": {
    "_postman_id": "a1b2c3d4-claims-processing-service",
    "name": "Claims Processing Service API",
    "description": "API collection for the Claims Processing Service (port 8082). Manages insurance claims including submission, review, approval, rejection, and payment workflows.",
