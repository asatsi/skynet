python3 - << 'PYEOF'
import os
path = os.environ["PROJECT_PATH"] + "/ui/index.html"
with open(path) as f:
    html = f.read()

# Fix 1: Pure Math.random UUID — no crypto/secure-context needed
if "crypto.randomUUID" in html:
    html = html.replace(
        "currentThread||(currentThread=crypto.randomUUID())",
        "currentThread||(currentThread=uuidv4())"
    )
    uuid_fn = """function uuidv4(){return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,function(c){var r=Math.random()*16|0;return(c==='x'?r:(r&0x3|0x8)).toString(16);});}
"""
    html = uuid_fn + html
    print("✅ Fix 1: uuidv4() added")
else:
    print("⏭  Fix 1: already done")

# Fix 2: Safe clearRP — removeChild loop instead of innerHTML=''
broken = "$('rp-scroll').innerHTML=''; $('rp-scroll').appendChild($('rp-empty')); $('rp-empty').style.display='';"
safe   = "var sc=$('rp-scroll'),emp=$('rp-empty');if(sc){while(sc.firstChild)sc.removeChild(sc.firstChild);}if(sc&&emp){sc.appendChild(emp);emp.style.display='';}"
if broken in html:
    html = html.replace(broken, safe)
    print("✅ Fix 2: clearRP() safe removeChild loop")
else:
    print("⏭  Fix 2: already done")

# Fix 3: Add Accept + Cache-Control to fetch
old_fetch = "method:'POST',headers:{'Content-Type':'application/json'},"
new_fetch = "method:'POST',headers:{'Content-Type':'application/json','Accept':'text/event-stream','Cache-Control':'no-cache'},credentials:'omit',"
if old_fetch in html:
    html = html.replace(old_fetch, new_fetch)
    print("✅ Fix 3: fetch headers for SSE")
else:
    print("⏭  Fix 3: already done")

# Fix 4: Better error display — show exception type+message
old_err = "'⚠️ '+esc(ev.text);"
new_err = "'⚠️ '+(ev.text||'Agent error — check server logs');"
if old_err in html:
    html = html.replace(old_err, new_err)
    print("✅ Fix 4: error bubble shows fallback message")
else:
    print("⏭  Fix 4: already done")

with open(path, "w") as f:
    f.write(html)
print("\n✅ index.html patched — restart the agent-server container")
PYEOF
